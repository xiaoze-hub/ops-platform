# ops-platform environment template
# Copy to .env at worktree/repo root, then fill REAL values locally.
# NEVER commit .env / real secrets / node tokens (see .gitignore).

# --- PostgreSQL (service name `db` inside compose network) ---
DB_HOST=db
DB_PORT=5432
DB_USER=ops
# Placeholder only — generate a strong password on the deploy host
DB_PASSWORD=change-me-strong
DB_NAME=ops_platform

# --- Platform auth ---
# JWT signing key — generate on deploy host, e.g. openssl rand -hex 32
SECRET_KEY=change-me-jwt-secret
# Initial admin password; first login forces a password change
ADMIN_PASSWORD=change-me-admin

# --- Feature flags / retention ---
# project_deploy is OFF by default (security). Set true only when needed.
PROJECT_DEPLOY_ENABLED=false
METRICS_RETENTION_DAYS=7
LOGS_RETENTION_DAYS=3
